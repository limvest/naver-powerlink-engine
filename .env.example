# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/naver_powerlink_engine

# 32-byte key, base64 (openssl rand -base64 32). Encrypts the Naver SearchAd API key and secret at rest.
CRED_ENC_KEY=

# Scripts that write to the ad account refuse to run unless this is 1.
ENGINE_LIVE=0

# Optional: outbound proxy for rank observation requests
NAVER_RANK_PROXY_URL=
